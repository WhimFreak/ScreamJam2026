[sub_resource type="Resource" id="Resource_1v2cy"]
script = ExtResource("1_npei6")
character_name = "Rudy"
text = "But I guess you never know until you try."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_j05eh"]
script = ExtResource("1_npei6")
character_name = "Rosila"
portrait = ExtResource("5_10y5h")
text = "Believe me son… You will get your answers, but first you have to find yourself."
