[sub_resource type="Resource" id="Resource_quxoa"]
script = ExtResource("1_npei6")
delay_before_next = 1.0
signal_on_advance = "fade_in"
character_name = "Rosila"
portrait = ExtResource("4_oj845")
text = "It's not your fault."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_oj845"]
script = ExtResource("1_npei6")
character_name = "Rosila"
portrait = ExtResource("4_oj845")
text = "You could have never guessed.. that this could have happened."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_i1u5e"]
script = ExtResource("1_npei6")
delay_before_next = 0.5
character_name = "Rudy"
text = "But maybe I did do things which led to that."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_10y5h"]
script = ExtResource("1_npei6")
delay_before_next = 1.0
