[sub_resource type="Resource" id="Resource_nv1j6"]
script = ExtResource("1_npei6")
character_name = "Rudy"
text = "She even said she'd pick me up."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_4vygj"]
script = ExtResource("1_npei6")
