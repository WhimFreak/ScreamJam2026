[sub_resource type="Resource" id="Resource_a8nu7"]
script = ExtResource("1_npei6")
character_name = "Rudy"
text = "Alright, I'll try."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_3p4yq"]
script = ExtResource("1_npei6")
character_name = "Rudy"
text = "I only came here since May wants me to get sorted out and start back up."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_iq8m7"]
script = ExtResource("1_npei6")
character_name = "Rudy"
