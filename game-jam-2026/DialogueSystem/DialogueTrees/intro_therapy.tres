[sub_resource type="Resource" id="Resource_ujjlp"]
script = ExtResource("1_npei6")
character_name = "Rosila"
portrait = ExtResource("5_10y5h")
text = "You know what…. You should really start talking and socializing more."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_rdqbo"]
script = ExtResource("1_npei6")
delay_before_next = 0.5
character_name = "Rosila"
portrait = ExtResource("3_quxoa")
text = "I know it won’t bring her back, but that’s something you have to accept and move on."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_a4a14"]
script = ExtResource("1_npei6")
delay_before_next = 0.5
character_name = "Rudy"
text = "Don't you come under 'more'?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_eguiy"]
script = ExtResource("1_npei6")
character_name = "Rosila"
