text = "Oh my god, you're out! Are you alright?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_8e8q0"]
script = ExtResource("1_om4f4")
character_name = "May"
portrait = ExtResource("4_6ibqm")
text = "I am so sorry for what happened! I shouldn’t have invited Mark. He said he wouldn't bring it up but-"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_wp56q"]
