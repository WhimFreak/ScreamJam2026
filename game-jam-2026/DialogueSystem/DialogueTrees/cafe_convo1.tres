[sub_resource type="Resource" id="Resource_65ca2"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "I laughed once..."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ya2rd"]
script = ExtResource("1_0pbus")
character_name = "May"
text = "I'll take it."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_df1bg"]
script = ExtResource("1_0pbus")
character_name = "Mark"
text = "What you two blabbering about? Well anyway, I ordered drinks for ya’ll in advance!"
