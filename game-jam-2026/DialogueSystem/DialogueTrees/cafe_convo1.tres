[gd_resource type="Resource" script_class="DialogueTree" format=3 uid="uid://cctyukxbit6m1"]

[ext_resource type="Script" uid="uid://dsklo1nyldsmy" path="res://DialogueSystem/dialogue_items.gd" id="1_0pbus"]
[ext_resource type="Script" uid="uid://cpa1tl0l7wdrq" path="res://DialogueSystem/dialogue_choices.gd" id="2_300mh"]
[ext_resource type="AudioStream" uid="uid://cy1qrpm4ftrhn" path="res://testing_assets/talking_synth.ogg" id="3_l3lep"]
[ext_resource type="Texture2D" uid="uid://dyemk75vu6h6a" path="res://testing_assets/nigum.png" id="5_718xj"]
[ext_resource type="Script" uid="uid://dq5m317pm5mk6" path="res://DialogueSystem/DialogueTrees/dialogue_tree.gd" id="6_nb3rr"]

[sub_resource type="Resource" id="Resource_estei"]
script = ExtResource("1_0pbus")
character_name = "Abigail"
text = "Finally!! You are here!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_r44pi"]
script = ExtResource("1_0pbus")
text = "We’re really sorry guys! There’s a lot of traffic today due to the Carnival nearby..."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_qm6hb"]
script = ExtResource("1_0pbus")
text = "For a second I thought you guys weren’t coming along!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_gisau"]
script = ExtResource("1_0pbus")
text = "yeah! I have inhaled like 2 pizzas already while waiting…"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_yyecf"]
script = ExtResource("1_0pbus")
text = "(yeah, mark hasn’t changed at all..)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ktsms"]
script = ExtResource("1_0pbus")
text = "….."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_2t2me"]
script = ExtResource("1_0pbus")
text = "umm… sorry about that !"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_fkywb"]
script = ExtResource("1_0pbus")
text = "So…., where were we?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_je0y3"]
script = ExtResource("1_0pbus")
text = "yeah, the carnival. It’s been too long since I went to one."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_b3rig"]
script = ExtResource("1_0pbus")
text = "WE WERE AT them being late !!!!!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_owin8"]
script = ExtResource("1_0pbus")
text = "( Abigail is as always, that one girl who gets overly conscious about things)
"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_k5o0u"]
script = ExtResource("1_0pbus")
text = "( I guess there’s nothing bad about it, just that I don’t relate to that trait that much)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_1me10"]
script = ExtResource("1_0pbus")
text = "( or maybe I just can’t)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_hhu8m"]
script = ExtResource("1_0pbus")
text = "oh…right. I am sorry again!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_80swo"]
script = ExtResource("1_0pbus")
text = "I’m starting to think I should’ve stayed home."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_k2rqm"]
script = ExtResource("1_0pbus")
text = "(may stares the shit out of me)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_0u6xh"]
script = ExtResource("1_0pbus")
text = "Abigail - PLease don’t say that!!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_2fd1a"]
script = ExtResource("1_0pbus")
text = "I am really happy you came today!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_noo73"]
script = ExtResource("1_0pbus")
text = "Too late anyways. We have a strict attendance policy. One absence and we sell your belongings."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_mji5h"]
script = ExtResource("1_0pbus")
text = "We sold his dignity years ago. Nobody wanted to buy it."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_jffff"]
script = ExtResource("1_0pbus")
text = "You people are why I have trust issues!!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_fk3jp"]
script = ExtResource("1_0pbus")
text = "(I let out a small laugh. May notices but doesn't make a big deal out of it.)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_4e6pm"]
script = ExtResource("1_0pbus")
text = "See? Five minutes in and you're already having fun."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_65ca2"]
script = ExtResource("1_0pbus")
text = "I laughed once."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ya2rd"]
script = ExtResource("1_0pbus")
text = "I'll take it."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_df1bg"]
script = ExtResource("1_0pbus")
text = "what you two blabbering! Anyways… I ordered refreshments for ya’all in advance!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_drmks"]
script = ExtResource("1_0pbus")
text = "since when did you become so caring?!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ursju"]
script = ExtResource("1_0pbus")
text = "from the day your boy got into a relationship."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_kt203"]
script = ExtResource("1_0pbus")
text = "bullshit! You don’t have a girlfriend"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_3w4rw"]
script = ExtResource("1_0pbus")
text = "more like… you can’t have a girlfriend."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_dm4vr"]
script = ExtResource("1_0pbus")
text = "oh don’t hate me cuz I am beautiful n-"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_i54vc"]
script = ExtResource("1_0pbus")
text = "The devs would advise you to not complete that joke!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_lpwm6"]
script = ExtResource("1_0pbus")
text = "yeah, devs my ass !!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_0ojwt"]
script = ExtResource("1_0pbus")
text = "( ? devs will remember that)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_i6v1t"]
script = ExtResource("1_0pbus")
text = "Sometimes I get reminded by these two, that there is a whole different world about videogames out there.."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_x3fca"]
script = ExtResource("1_0pbus")
text = "I know right ! well it’s been so long since we got together that I forgot about these niche references.."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_5bcis"]
script = ExtResource("1_0pbus")
text = "And I know things haven't exactly been easy for you rudy.."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_cxjyd"]
script = ExtResource("1_0pbus")
text = "(The table grows a little quieter, but not uncomfortably so)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_k63s5"]
script = ExtResource("1_0pbus")
text = "You don't have to talk about anything you don't want to..."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_3x1tn"]
script = ExtResource("1_0pbus")
text = "I just want you to know that we haven't forgotten you, okay?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_crq3r"]
script = ExtResource("1_0pbus")
text = "(I look down at my drink)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_0pbus"]
script = ExtResource("1_0pbus")
text = "Sometimes I just think about what is real and what could have been real."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_300mh"]
script = ExtResource("1_0pbus")
text = "Real.."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_l3lep"]
script = ExtResource("1_0pbus")
text = "( Is this guy for real ?!)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ia8e2"]
script = ExtResource("1_0pbus")
text = "That's not the comforting comparison you think about!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_718xj"]
script = ExtResource("1_0pbus")
text = "That’s true. We are trying to establish solidarity here…"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_nb3rr"]
script = ExtResource("1_0pbus")
text = "(I smile faintly)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ty5vu"]
script = ExtResource("1_0pbus")
text = "I know. Thanks."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ux3b5"]
script = ExtResource("1_0pbus")
text = "You don't have to catch up with everyone, you know."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_18frt"]
script = ExtResource("1_0pbus")
text = "(She speaks gently, without making me look directly at her.)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_0yqc5"]
script = ExtResource("1_0pbus")
text = "You can just be here. That's enough for today."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_5xda3"]
script = ExtResource("1_0pbus")
text = "(I look at her. For a moment, I don't know what to say)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_dtdr2"]
script = ExtResource("1_0pbus")
text = "I think I needed to hear that...."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_2bjm1"]
script = ExtResource("1_0pbus")
text = "Then I'm glad you came."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_pb4ad"]
script = ExtResource("1_0pbus")
text = "(She gives me a small smile. I return it as well)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_n4dus"]
script = ExtResource("1_0pbus")
text = " Okay, this is getting dangerously wholesome!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_cee64"]
script = ExtResource("1_0pbus")
text = "Well then how about this…"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_y1rqq"]
script = ExtResource("1_0pbus")
text = "Your haircut looks like you lost a bet with a lawn mower!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_8pha5"]
script = ExtResource("1_0pbus")
text = "There it is. My people."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_b6l1u"]
script = ExtResource("2_300mh")
text = "I've had worse days"
target_line_idx = 60
metadata/_custom_type_script = "uid://cpa1tl0l7wdrq"

[sub_resource type="Resource" id="Resource_r2cj4"]
script = ExtResource("2_300mh")
text = "I actually had a good time"
target_line_idx = 64
metadata/_custom_type_script = "uid://cpa1tl0l7wdrq"

[sub_resource type="Resource" id="Resource_ik3ie"]
script = ExtResource("1_0pbus")
choices = Array[ExtResource("2_300mh")]([SubResource("Resource_b6l1u"), SubResource("Resource_r2cj4")])
click_advance = false
text = "So?.... Be honest. Was coming here really that terrible?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_88eib"]
script = ExtResource("1_0pbus")
text = "Let's say, I've had worse days."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_mapdo"]
script = ExtResource("1_0pbus")
text = "That's basically a five-star review from him!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_vxuos"]
script = ExtResource("1_0pbus")
text = "I'll put it on our restaurant page"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_6m540"]
script = ExtResource("2_300mh")
text = "just kidding!"
metadata/_custom_type_script = "uid://cpa1tl0l7wdrq"

[sub_resource type="Resource" id="Resource_jf370"]
script = ExtResource("2_300mh")
text = "yeah..."
metadata/_custom_type_script = "uid://cpa1tl0l7wdrq"

[sub_resource type="Resource" id="Resource_rkoaw"]
script = ExtResource("1_0pbus")
choices = Array[ExtResource("2_300mh")]([SubResource("Resource_6m540"), SubResource("Resource_jf370")])
click_advance = false
text = "I'll take it."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_3axj6"]
script = ExtResource("1_0pbus")
text = "I actually had a good time!!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_l3qvu"]
script = ExtResource("1_0pbus")
text = "(May looks genuinely pleased)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_s1mou"]
script = ExtResource("1_0pbus")
text = "Yeah?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_7tss4"]
script = ExtResource("1_0pbus")
text = "Yeah. I think I needed this more than I realized."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_tl1pj"]
script = ExtResource("1_0pbus")
text = "Someone record the date. We have achieved a positive review."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_6omly"]
script = ExtResource("1_0pbus")
text = "Don't ruin it."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_u2vtl"]
script = ExtResource("1_0pbus")
text = "(The group has been sitting together for a while. Empty cups and plates cover the table)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ym6hf"]
script = ExtResource("1_0pbus")
text = "(Mark leans back in his chair, looking far too pleased with himself)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_682c1"]
script = ExtResource("1_0pbus")
text = "You know what? We should do this every week."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_51idl"]
script = ExtResource("1_0pbus")
text = "I guess broo.."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_gl40u"]
script = ExtResource("1_0pbus")
text = "NO I am being serious"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_s3xol"]
script = ExtResource("1_0pbus")
text = " I'd be happy with that."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_enbcl"]
script = ExtResource("1_0pbus")
text = "Of course you would. Especially now that Rudy is finally coming out of his cave."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_2eyrr"]
script = ExtResource("1_0pbus")
text = "Mark.."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_e7r0u"]
script = ExtResource("1_0pbus")
text = "What? I'm happy he's here!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_nlxav"]
script = ExtResource("1_0pbus")
text = "Then just say that!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ehwbg"]
script = ExtResource("1_0pbus")
text = "Fine! I'm happy you're here, man."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_886v0"]
script = ExtResource("1_0pbus")
text = "(He gives me an exaggerated thumbs-up)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_rherf"]
script = ExtResource("1_0pbus")
text = "Seriously, though!! It's good seeing you smile again..."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_6k1rk"]
script = ExtResource("1_0pbus")
text = "(I nod, a little embarrassed)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_xu4jm"]
script = ExtResource("1_0pbus")
text = "Thanks, man."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_4h8vv"]
script = ExtResource("1_0pbus")
text = "Besides, May's been trying to get you out for ages. .."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_fflk1"]
script = ExtResource("1_0pbus")
text = "I'm pretty sure she's been waiting for this moment since forever!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_rcdxe"]
script = ExtResource("1_0pbus")
text = "What is THAT supposed to mean?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_d77vw"]
script = ExtResource("1_0pbus")
text = "Oh, come on. Don't act like we don't know?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_3fxvc"]
script = ExtResource("1_0pbus")
text = "Mark. Leave it."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_h30t1"]
script = ExtResource("1_0pbus")
text = "What? I'm just saying what everyone already knows. You've always had a thing for him."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_fad1b"]
script = ExtResource("1_0pbus")
text = "(May's face changes. She looks embarrassed and immediately glances at me)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_uk7jt"]
script = ExtResource("1_0pbus")
text = "(maybe I did had a clue about this, but I have just started notice this)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_8djf2"]
script = ExtResource("1_0pbus")
text = "(does it matter anyways?)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_t6dw7"]
script = ExtResource("1_0pbus")
text = "Can we please not do this right now?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_d1qdp"]
script = ExtResource("1_0pbus")
text = "I'm not making fun of you! It's kind of sweet, actually."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_2dgb5"]
script = ExtResource("1_0pbus")
text = "You're making it weird. Stop."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_6mmp3"]
script = ExtResource("1_0pbus")
click_advance = false
delay_before_next = 3.0
text = "Fine, fine. I'm just saying... now that Ava's gone, you finally have a chance, right?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_qxla0"]
script = ExtResource("1_0pbus")
text = "(Is this real?)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_duayl"]
script = ExtResource("1_0pbus")
text = "(It just can’t be)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

