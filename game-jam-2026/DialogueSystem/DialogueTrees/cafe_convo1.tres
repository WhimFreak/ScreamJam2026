character_name = "Rudy"
text = "I guess bro...."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_i6v1t"]
script = ExtResource("1_0pbus")
delay_before_next = 1.0
character_name = "Mark"
text = "Hey Man!! it's a new era we live in! don't you know about CATBOYS?!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_x3fca"]
script = ExtResource("1_0pbus")
character_name = "Abigail"
text = "let's just PAUSE there you know.... It’s been so long since we last got together, huh?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_5bcis"]
script = ExtResource("1_0pbus")
character_name = "Abigail"
text = "and I know things haven't exactly been easy for you, Rudy."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_cxjyd"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "(The table grows a little quieter, but not uncomfortably so)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_k63s5"]
script = ExtResource("1_0pbus")
character_name = "Abigail"
text = "Hey, you don't have to talk about anything you don't want to."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_3x1tn"]
script = ExtResource("1_0pbus")
character_name = "Abigail"
text = "I just want you to know that we haven't forgotten you, okay?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_crq3r"]
script = ExtResource("1_0pbus")
delay_before_next = 0.5
character_name = "Rudy"
text = "(I look down at my drink with no emotions on face)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_0pbus"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "Well.. sometimes I just.. wonder what's real and what could have been real.."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_0yqc5"]
script = ExtResource("1_0pbus")
delay_before_next = 0.5
character_name = "Rudy"
text = "But I guess the hard part is not about moving on.
It's about accepting the reality first..."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_300mh"]
script = ExtResource("1_0pbus")
character_name = "Mark"
text = "Eh, I've got plenty active imagination too."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_l3lep"]
script = ExtResource("1_0pbus")
delay_before_next = 0.5
character_name = "Rudy"
text = "(only if  I could kill  one more person right now!)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_718xj"]
script = ExtResource("1_0pbus")
delay_before_next = 0.5
character_name = "Mark"
text = "Hey, just trying to relate here! I know it's really hard for you. None of us know what happened to Ava exactly..."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_nb3rr"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "I hope someday we'll find out...."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_ux3b5"]
script = ExtResource("1_0pbus")
character_name = "May"
text = "You don't have to catch us up on all of it today, you know. You can just be here."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_5xda3"]
script = ExtResource("1_0pbus")
delay_before_next = 0.5
character_name = "Rudy"
text = "(She looks at me with too much hope..)"
