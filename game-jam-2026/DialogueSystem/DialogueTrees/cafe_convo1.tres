[sub_resource type="Resource" id="Resource_owin8"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "(Abigail as always, gets overly conscious about things.)
"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_k5o0u"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "(I guess there’s nothing wrong about it, though we're way different in that regard.)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_1me10"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "(well,.... who am I to talk about weird psychological behaviour..?)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_hhu8m"]
script = ExtResource("1_0pbus")
character_name = "Mark"
text = "Oh right. I'm sorry again!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_80swo"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "Well now, I’m starting to think I should’ve stayed home."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_k2rqm"]
script = ExtResource("1_0pbus")
character_name = "Rudy"
text = "(I try to ignore May staring right through my soul..)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_0u6xh"]
script = ExtResource("1_0pbus")
character_name = "Abigail"
text = "Oh, please don’t say that! We're really happy you came today!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_noo73"]
script = ExtResource("1_0pbus")
character_name = "Mark"
text = "You're too late anyway!! We have a strict attendance policy. One absence and we SELL YOUR BELONGINGS!!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_mji5h"]
script = ExtResource("1_0pbus")
character_name = "Abigail"
text = "Right, Mark. If we did that, you'd have nothing left to sell but your dignity. And nobody wants to buy that..."
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_jffff"]
script = ExtResource("1_0pbus")
character_name = "Mark"
text = "Ouch!!"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_fk3jp"]
script = ExtResource("1_0pbus")
delay_before_next = 0.5
character_name = "Rudy"
text = "(I let out a small laugh. May notices and smiles smugly, lowering her voice.)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_4e6pm"]
script = ExtResource("1_0pbus")
character_name = "May"
text = "See? Five minutes in and you're already having fun!"
