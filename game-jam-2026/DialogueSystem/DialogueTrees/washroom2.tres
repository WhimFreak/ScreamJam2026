[sub_resource type="Resource" id="Resource_xnt8u"]
script = ExtResource("1_guyx0")
character_name = "Rudy"
text = "(My eyes snapped to the door, startled by the sudden knocking.)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_5yqmh"]
script = ExtResource("1_guyx0")
character_name = "Rudy"
text = "(Was that May? God, I hope that was May. And I hope that was her doing the whispering too.)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_3r06q"]
script = ExtResource("1_guyx0")
character_name = "Rudy"
text = "(Why would she do something like that to try and scare me though?)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_722cl"]
script = ExtResource("1_guyx0")
character_name = "May"
text = "Rudy, are you okay?"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_lb505"]
script = ExtResource("1_guyx0")
stop_music = true
character_name = "Rudy"
text = "(I let out a breath. Of course it's her. I don't know what I was so afraid of.)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_jk8av"]
