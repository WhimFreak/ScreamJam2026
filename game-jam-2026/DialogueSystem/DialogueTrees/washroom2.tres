[sub_resource type="Resource" id="Resource_ybuti"]
script = ExtResource("1_guyx0")
delay_before_next = 1.0
signal_on_advance = "fade_to_black"
character_name = "Rudy"
text = "(I swear I could hear someone talking. To me?)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_4jp8f"]
script = ExtResource("1_guyx0")
hide_image_after = true
music = ExtResource("6_j648x")
music_fade_time = 0.0
music_volume_db = -25.0
character_name = "Rudy"
text = "(I close my eyes, trying to gauge where the noise is coming from. But it feels like it's everywhere.)"
metadata/_custom_type_script = "uid://dsklo1nyldsmy"

[sub_resource type="Resource" id="Resource_e72ou"]
